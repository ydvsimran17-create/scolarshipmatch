# ==============================================================================
# Scholarship Match - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' or '.env.local' in the project root to configure
# your local environment.
#
# NOTE: When VITE_API_BASE_URL is left unset or empty, the frontend runs in
# standalone DEMO MODE using local mock datasets and localStorage persistence.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration
# ------------------------------------------------------------------------------
# Backend REST API Base URL (do not include trailing slash)
# Example (Local Development): VITE_API_BASE_URL=http://localhost:5000/api
# Example (Production):        VITE_API_BASE_URL=https://api.scholarshipmatch.example.com/api
VITE_API_BASE_URL=

# Optional: HTTP Request Timeout in milliseconds (default: 15000)
VITE_API_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 2. Backend Server Configuration (for local server execution)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Local PostgreSQL connection: postgres://USERNAME:PASSWORD@localhost:5432/scholarshipmatch
DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/scholarshipmatch

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here
# Optional: GEMINI_MODEL=gemini-2.5-flash

# Optional: SMTP email sending (without these, emails log to console or test inbox)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
