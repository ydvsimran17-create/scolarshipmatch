PORT=5000
NODE_ENV=development

# Local PostgreSQL connection: postgres://USERNAME:PASSWORD@localhost:5432/scholarshipmatch
DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/scholarshipmatch

JWT_SECRET=put_a_long_random_string_here
JWT_EXPIRES_IN=7d

# Free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here
# Optional: change if the default model name stops working
# GEMINI_MODEL=gemini-3.5-flash

# Optional: real email sending (without these, emails go to a test inbox or the console)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=